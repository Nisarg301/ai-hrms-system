# ---------------------------------------------------------------------------
# Client environment. Copy to `.env` and adjust:
#   cp .env.example .env
# Vite only exposes variables prefixed with VITE_, and they are baked into the
# bundle at build time, so never put secrets here. Restart `npm run dev` after
# changing this file.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the /api/v1 prefix.
# Defaults to http://localhost:4000/api/v1 when unset.
VITE_API_BASE_URL=http://localhost:4000/api/v1
