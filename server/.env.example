# ---------------------------------------------------------------------------
# Server environment. Copy to `.env` and fill in the values:
#   cp .env.example .env
# Validated at startup by src/config/env.ts; the server will not boot if a
# required value is missing.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=4000

# REQUIRED. MongoDB connection string (local mongod, Docker, or Atlas), e.g.
#   mongodb://127.0.0.1:27017/rbac-system
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rbac-system
MONGODB_URI=mongodb://127.0.0.1:27017/rbac-system

# REQUIRED. Long random strings, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Exact origin of the frontend (scheme + host + port, no trailing slash).
# Must match, or the browser blocks requests and the refresh cookie.
CORS_ORIGIN=http://localhost:5173
# Public origin of this API, used to build absolute URLs (e.g. avatars) in responses
API_BASE_URL=http://localhost:4000

# First Super Admin, created by `npm run seed:superadmin` (password: min 8 chars)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Super Admin

# Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys).
# Use test-mode keys (rzp_test_...) in development. Optional: without them the
# payment endpoints return 503. The secret is backend only.
RAZOR_PAY_API_KEY=
RAZOR_PAY_SECRET=

# Email. Leave SMTP_HOST empty in development to use a throwaway Ethereal inbox
# (each email prints a preview link in the server console).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = a 16-character
# App Password (myaccount.google.com/apppasswords). Port 465 = TLS, others = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sentinel <no-reply@sentinel.local>"

# AI assistant on a local Ollama (Professional plan only). See docs/AI_ASSISTANT_PLAN.md.
# Off unless AI_ENABLED=true. Pull the model first: ollama pull qwen2.5:3b
AI_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional tuning (defaults shown). AI_INTERNAL_API_BASE defaults to http://127.0.0.1:$PORT/api/v1.
AI_INTERNAL_API_BASE=
AI_MAX_TOOL_STEPS=4
AI_MAX_CONCURRENT=1
AI_REQUEST_TIMEOUT_MS=180000
AI_NUM_CTX=4096
AI_FAST_READS=true
AI_HISTORY_DAYS=30
